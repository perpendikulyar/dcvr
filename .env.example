# Copy to .env and adjust. Real environment variables take precedence.

# LLM provider for AI analysis: yandex | openai-compatible
# (Vireonix is not supported: its terms forbid automated bulk processing.)
LLM_PROVIDER=yandex

# --- Yandex AI Studio (LLM_PROVIDER=yandex) ---
# Service account API key and the folder it belongs to.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Parallel requests; AI Studio allows 5 concurrent completions by default.
# YANDEX_CONCURRENCY=4
# Optional model overrides (defaults: yandexgpt-lite for tagging, yandexgpt for synthesis):
# YANDEX_MAP_MODEL=gpt://<folder>/yandexgpt-lite/latest
# YANDEX_SYNTH_MODEL=gpt://<folder>/yandexgpt/latest

# --- Any OpenAI-compatible API (LLM_PROVIDER=openai-compatible), e.g. OpenRouter, Ollama ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MAP_MODEL=
# LLM_SYNTH_MODEL=
# LLM_CONCURRENCY=4
